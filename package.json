{
  "name": "legendary-images",
  "version": "1.0.0",
  "description": "React client and node server for image upload CRUD",
  "homepage": "https://github.com/p00k1ew00k1e/legendary-images#readme",
  "bugs": {
    "url": "https://github.com/p00k1ew00k1e/legendary-images/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/p00k1ew00k1e/legendary-images.git"
  },
  "license": "ISC",
  "author": "PF",
  "type": "commonjs",
  "main": "index.js",
  "scripts": {
    "install:client": "cd client && npm install",
    "install:server": "cd server && npm install",
    "postinstall": "concurrently \"npm run install:server\" \"npm run install:client\"",
    "test": "echo \"Error: no test specified\" && exit 1",
    "start:client": "cd client && npm start",
    "start:server": "cd server && npm start",
    "start": "concurrently \"npm run start:server\" \"npm run start:client\""
  },
  "devDependencies": {
    "concurrently": "^10.0.7"
  }
}
